{
  "name": "music-tracks-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "vitest run tests/unit --config vitest.unit.config.ts",
    "test:unit:watch": "vitest tests/unit --config vitest.unit.config.ts",
    "test:components": "jest",
    "test:components:watch": "jest --watch",
    "test:components:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test:unit && npm run test:components && npm run test:e2e",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write 'src/**/*.{ts,html,scss}'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/material": "^18.2.14",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@mobily/ts-belt": "^3.13.1",
    "@tanstack/angular-query-experimental": "^5.81.2",
    "eslint-plugin-neverthrow": "^1.1.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "wavesurfer.js": "^7.9.4",
    "zod": "^3.25.42",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.9",
    "@angular/cli": "^18.2.9",
    "@angular/compiler-cli": "^18.2.0",
    "@playwright/test": "^1.53.1",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@vitest/ui": "^3.2.4",
    "angular-eslint": "19.3.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "jasmine-core": "~5.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.6.0",
    "jsdom": "^26.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-mocks": "^14.13.5",
    "prettier": "^3.5.3",
    "typescript": "~5.5.2",
    "typescript-eslint": "8.27.0",
    "vitest": "^3.2.4"
  }
}
